# Copy the settings you need into Netlify → Site configuration → Environment variables.
# Never put real keys in this file or commit them: this file is only a list.
# Everything is optional; each feature switches on when its settings are present.

# ---- Shown to the browser (safe to be public) ----
REACT_APP_PAYMENTS=on                      # turns on "Pay" at checkout
REACT_APP_SUPABASE_URL=                    # Supabase → Project Settings → API → Project URL
REACT_APP_SUPABASE_ANON_KEY=               # same page → anon / public key
REACT_APP_UMAMI_WEBSITE_ID=                # Umami → Websites → your site → Website ID

# ---- Server only (secret) ----
SUPABASE_URL=                              # same as REACT_APP_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=                 # Supabase → Project Settings → API → service_role key (secret!)
PAYSTACK_SECRET_KEY=                       # Paystack → Settings → API Keys → Secret key (sk_test_… first, sk_live_… later)

# Order emails (Resend). Customers only get emails once your domain is verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Nula Leer <orders@yourdomain.com>
OWNER_EMAIL=kosenchajennifer@gmail.com     # where new-order alerts go

# Order SMS (Africa's Talking). Use AT_USERNAME=sandbox while testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=                              # leave empty until a sender ID is approved
